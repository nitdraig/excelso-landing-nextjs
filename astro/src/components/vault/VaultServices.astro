---
import type { Locale } from "@/lib/seo";
import { localizePath } from "@/lib/i18n";
import { vaultCopy, vaultServices } from "@/content/vault";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = vaultCopy[locale];
---

<section class="w-full bg-muted/30 py-12 md:py-24 lg:py-32">
  <div class="container md:px-6">
    <div class="reveal mb-12 flex flex-col items-center justify-center space-y-4 text-center">
      <span class="badge">{c.servicesBadge}</span>
      <h2 class="text-3xl font-bold tracking-tighter md:text-4xl/tight">
        {c.servicesTitle}
      </h2>
      <p
        class="max-w-[900px] text-muted-foreground md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed"
      >
        {c.servicesLead}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        vaultServices.map((service) => {
          const copy = service[locale];
          const labPath = "labPath" in service ? service.labPath : undefined;
          const labCta = "labCta" in copy ? copy.labCta : undefined;
          return (
            <div class="reveal group relative overflow-hidden rounded-lg border bg-background p-6 transition-transform hover:-translate-y-1">
              <div class="flex flex-col space-y-4">
                <div class="flex size-12 items-center justify-center rounded-full border">
                  <Icon name={service.icon} class="size-6" />
                </div>
                <h3 class="text-xl font-bold">{copy.title}</h3>
                <p class="text-muted-foreground">{copy.description}</p>
                {
                  labPath && labCta && (
                    <a
                      href={localizePath(labPath, locale)}
                      class="inline-flex items-center gap-1 text-sm font-medium text-foreground hover:underline"
                    >
                      {labCta}
                      <Icon name="arrow-right" class="size-4" />
                    </a>
                  )
                }
              </div>
              <div class="absolute bottom-0 left-0 h-1 w-0 bg-foreground transition-all duration-300 group-hover:w-full"></div>
            </div>
          );
        })
      }
    </div>

    <div class="reveal mt-12 text-center">
      <a href={localizePath("/contact", locale)} class="btn btn-lg btn-primary group">
        {c.servicesCta}
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>
