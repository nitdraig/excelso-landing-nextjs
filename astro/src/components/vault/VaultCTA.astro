---
import type { Locale } from "@/lib/seo";
import { localizePath } from "@/lib/i18n";
import { vaultCopy } from "@/content/vault";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = vaultCopy[locale];
---

<section class="w-full border-t bg-muted/50 py-12 md:py-24 lg:py-32">
  <div class="container grid items-center gap-6 md:px-6 lg:grid-cols-2 lg:gap-10">
    <div class="reveal space-y-2">
      <h2 class="text-3xl font-bold tracking-tighter md:text-4xl/tight">
        {c.ctaTitle}
      </h2>
      <p
        class="max-w-[600px] text-muted-foreground md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed"
      >
        {c.ctaLead}
      </p>
    </div>
    <div class="reveal flex gap-4 lg:justify-end">
      <a href={localizePath("/contact", locale)} class="btn btn-primary group">
        {c.ctaContact}
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>
