---
import type { Locale } from "@/lib/seo";
import { localizePath } from "@/lib/i18n";
import { vaultCopy } from "@/content/vault";
import { caseStudies } from "@/data/data";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = vaultCopy[locale];
const featured = caseStudies.slice(0, 3);
---

<section class="w-full py-12 md:py-24 lg:py-32" id="vault-projects">
  <div class="container md:px-6">
    <div class="reveal mb-12 flex flex-col items-center justify-center space-y-4 text-center">
      <h2 class="text-3xl font-bold tracking-tighter md:text-4xl/tight">
        {c.projectsTitle}
      </h2>
      <p
        class="max-w-[900px] text-muted-foreground md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed"
      >
        {c.projectsLead}
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((project) => (
          <a
            href={localizePath(`/vault/case-studies/${project.id}`, locale)}
            class="reveal group relative block overflow-hidden rounded-lg border bg-background transition-all hover:-translate-y-1 hover:shadow-md"
          >
            <div class="relative h-48 w-full overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="size-full object-cover transition-transform group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent opacity-0 transition-opacity group-hover:opacity-60"></div>
              <div class="absolute top-2 left-2">
                <span class="badge badge-solid">
                  <Icon name="lock" class="mr-1 size-3" />
                  Vault
                </span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold">{project.title}</h3>
              <div class="mt-1 flex items-center text-sm text-muted-foreground">
                <span class="font-medium">{project.client}</span>
                <span class="mx-2">•</span>
                <span>{project.industry}</span>
              </div>
              <p class="mt-3 mb-4 line-clamp-3 text-muted-foreground">
                {project.challenge}
              </p>
              <div class="mb-4 flex flex-wrap gap-2">
                {project.technologies.slice(0, 2).map((tech) => (
                  <span class="badge badge-muted">{tech}</span>
                ))}
                {project.technologies.length > 2 && (
                  <span class="badge badge-muted">
                    +{project.technologies.length - 2} {c.more}
                  </span>
                )}
              </div>
              <div class="flex items-center text-sm font-medium">
                {c.viewCase}
                <Icon name="arrow-right" class="ml-1 size-4" />
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="reveal mt-12 text-center">
      <a
        href={localizePath("/vault/case-studies", locale)}
        class="btn btn-lg btn-primary group"
      >
        {c.viewAll}
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>
