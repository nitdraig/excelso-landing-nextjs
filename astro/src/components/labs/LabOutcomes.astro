---
import type { Locale } from "@/lib/seo";
import { localizePath } from "@/lib/i18n";
import { labsCopy } from "@/content/labs";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = labsCopy[locale];
---

<section class="w-full py-12 md:py-20" id="lab-outcomes">
  <div class="container md:px-6">
    <div class="reveal mx-auto mb-10 max-w-3xl space-y-3 text-center">
      <h2 class="text-3xl font-bold tracking-tighter md:text-4xl/tight">{c.outcomesTitle}</h2>
      <p class="text-muted-foreground md:text-lg">{c.outcomesLead}</p>
    </div>
    <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-2">
      <a
        href={localizePath("/open", locale)}
        class="reveal group rounded-lg border bg-background p-6 transition-transform hover:-translate-y-1"
      >
        <div class="mb-3 flex items-center gap-2">
          <Icon name="code" class="size-6" />
          <h3 class="text-xl font-bold">{c.openTrackTitle}</h3>
        </div>
        <p class="text-muted-foreground leading-relaxed">{c.openTrackLead}</p>
        <p
          class="mt-4 inline-flex items-center gap-1 text-sm font-medium group-hover:underline"
        >
          {c.ctaOpen}
          <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
        </p>
      </a>
      <a
        href={localizePath("/vault", locale)}
        class="reveal group rounded-lg border bg-background p-6 transition-transform hover:-translate-y-1"
      >
        <div class="mb-3 flex items-center gap-2">
          <Icon name="lock" class="size-6" />
          <h3 class="text-xl font-bold">{c.vaultTrackTitle}</h3>
        </div>
        <p class="text-muted-foreground leading-relaxed">{c.vaultTrackLead}</p>
        <p
          class="mt-4 inline-flex items-center gap-1 text-sm font-medium group-hover:underline"
        >
          {c.ctaVault}
          <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
        </p>
      </a>
    </div>
  </div>
</section>
