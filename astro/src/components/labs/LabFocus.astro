---
interface Props {
  title: string;
  lead: string;
  items: readonly { title: string; description: string }[];
}

const { title, lead, items } = Astro.props;
---

<section class="w-full bg-muted/30 py-12 md:py-20">
  <div class="container md:px-6">
    <div class="reveal mx-auto mb-10 max-w-3xl space-y-3 text-center">
      <h2 class="text-3xl font-bold tracking-tighter md:text-4xl/tight">{title}</h2>
      <p class="text-muted-foreground md:text-lg">{lead}</p>
    </div>
    <div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2">
      {
        items.map((item) => (
          <div class="reveal rounded-lg border bg-background p-6">
            <h3 class="text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-muted-foreground leading-relaxed">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
