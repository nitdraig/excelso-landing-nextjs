---
import type { Locale } from "@/lib/seo";
import { localizePath } from "@/lib/i18n";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: Locale;
  title: string;
  lead: string;
  ctaContact: string;
  ctaOpen: string;
  ctaVault: string;
}

const { locale, title, lead, ctaContact, ctaOpen, ctaVault } = Astro.props;
---

<section class="w-full border-t bg-muted/50 py-12 md:py-24">
  <div class="container grid items-center gap-6 md:px-6 lg:grid-cols-2 lg:gap-10">
    <div class="reveal space-y-2">
      <h2 class="text-3xl font-bold tracking-tighter md:text-4xl/tight">{title}</h2>
      <p class="max-w-[600px] text-muted-foreground md:text-xl/relaxed">{lead}</p>
    </div>
    <div class="reveal flex flex-col gap-3 sm:flex-row lg:justify-end">
      <a href={localizePath("/contact", locale)} class="btn btn-primary group">
        {ctaContact}
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
      <a href={localizePath("/open", locale)} class="btn btn-outline group">
        {ctaOpen}
      </a>
      <a href={localizePath("/vault", locale)} class="btn btn-outline group">
        {ctaVault}
      </a>
    </div>
  </div>
</section>
