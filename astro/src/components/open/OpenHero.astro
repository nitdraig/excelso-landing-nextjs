---
import type { Locale } from "@/lib/seo";
import { localizePath } from "@/lib/i18n";
import { openCopy } from "@/content/open";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = openCopy[locale];
---

<section
  class="relative flex h-[500px] w-full items-center justify-center overflow-hidden border-b"
>
  <video
    src="/videos/bg2.webm"
    autoplay
    playsinline
    loop
    muted
    preload="metadata"
    class="absolute inset-0 z-0 size-full object-cover"
  ></video>
  <div class="absolute inset-0 z-10 bg-black/30 backdrop-blur-sm"></div>
  <div class="container relative z-20 md:px-6">
    <div class="max-w-2xl space-y-4">
      <h1 class="text-3xl font-bold tracking-tighter text-white sm:text-5xl xl:text-6xl">
        {c.title}
      </h1>
      <p class="max-w-[600px] text-white/90 md:text-xl">{c.lead}</p>
      <div class="flex flex-col gap-2 min-[400px]:flex-row">
        <a
          href="https://github.com/excelso-tech"
          class="btn btn-inverse group"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" class="size-4" />
          {c.ctaGithub}
          <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
        </a>
        <a href="#open-projects" class="btn btn-ghost-dark group">
          {c.ctaProjects}
          <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
        </a>
        <a href={localizePath("/labs", locale)} class="btn btn-ghost-dark group">
          {c.ctaLabs}
          <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </div>
</section>
