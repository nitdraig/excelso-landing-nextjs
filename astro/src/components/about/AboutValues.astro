---
import type { Locale } from "@/lib/seo";
import { aboutCopy } from "@/content/about";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = aboutCopy[locale];
---

<section class="w-full py-12 md:py-24 lg:py-32">
  <div class="container md:px-6">
    <div class="reveal flex flex-col items-center justify-center space-y-4 text-center">
      <h2 class="text-3xl font-bold tracking-tighter md:text-4xl/tight">
        {c.valuesTitle}
      </h2>
      <p
        class="max-w-[900px] text-muted-foreground md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed"
      >
        {c.valuesLead}
      </p>
    </div>
    <div class="mx-auto grid max-w-5xl gap-8 py-12 md:grid-cols-2 lg:grid-cols-3">
      {
        c.values.map((value) => (
          <div class="reveal flex flex-col space-y-2">
            <div class="flex items-center space-x-2">
              <div class="rounded-full bg-foreground p-1">
                <Icon name="check" class="size-4 text-background" />
              </div>
              <h3 class="font-bold">{value.title}</h3>
            </div>
            <p class="text-sm text-muted-foreground">{value.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
