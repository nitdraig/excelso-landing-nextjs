---
import type { Locale } from "@/lib/seo";
import { t } from "@/i18n/ui";

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
---

<section class="container py-20">
  <p class="mb-3 text-xs font-medium uppercase tracking-wider text-muted-foreground">
    {t(locale, "stub.badge")}
  </p>
  <h1 class="mb-4 text-4xl font-bold tracking-tight md:text-5xl">{title}</h1>
  <p class="max-w-2xl text-muted-foreground">{t(locale, "stub.body")}</p>
  <slot />
</section>
